{
  "files": {
    "includes": [
      "src/**",
      "*.json",
      "vite.config.ts",
      "index.html",
      "!package-lock.json",
      "!result.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
