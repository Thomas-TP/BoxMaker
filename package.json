{
  "name": "swiss3design-boxmaker",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cargo.ps1 build -p boxmaker-cli && vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "biome check . && tsc -b && cargo fmt --all -- --check && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cargo.ps1 test --locked && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cargo.ps1 clippy --locked -- -D warnings",
    "release:check": "bun scripts/check-release.ts",
    "format": "biome check --write . && cargo fmt --all",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.42.0",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8"
  }
}
